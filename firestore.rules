rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['areas','target'])));
      match /sales/{id} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
    }
  }
}
